name: CI

on:
  push:
  pull_request:

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.14'

      - name: Install system packages
        run: |
          sudo apt-get update
          sudo apt-get install -y firefox xvfb

      - name: Set up geckodriver
        uses: mozilla/setup-geckodriver@v1
        # optional input: geckodriver-version (e.g. 'v0.33.0')

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Run migrations
        run: python manage.py migrate --noinput

      - name: Run Django unit tests
        run: python manage.py test --verbosity=2

      - name: Run functional tests (Selenium)
        env:
          MOZ_HEADLESS: '1'
        run: xvfb-run -a python functional_tests.py -v
